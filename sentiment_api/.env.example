# sentiment_api — environment template
# Copy to .env and adjust.

# --- API ---
SENTIMENT_API_ENV=dev
# CORS_ORIGINS: comma-separated origins (e.g. http://localhost:3000 or http://80.211.210.49:3000 for remote UI)
# CORS_ORIGINS=http://localhost:3000,http://80.211.210.49:3000
SENTIMENT_API_API_KEYS=dev_key_change_me
SENTIMENT_API_LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql://sentiment:sentiment@localhost:5432/sentiment
SENTIMENT_API_DATABASE_URL=postgresql://sentiment:sentiment@localhost:5432/sentiment

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
SENTIMENT_API_REDIS_URL=redis://localhost:6379/0

# --- OpenAI (optional, for LLM/RAG) ---
OPENAI_API_KEY=

# --- Cost-effective + response API + batching (see docs/COST_EFFECTIVE.md, docs/RESPONSE_API_AND_BATCHING.md) ---
# COST_EFFECTIVE=true
# CLUSTER_SIMILARITY_THRESHOLD=0.88   # topic clustering (same story across outlets)
# MODEL_EMBEDDING_ID=openai:text-embedding-3-small:384
# MODEL_ESCALATION=gpt-5-mini

# --- Workers & clustering (see docs/WORK_DIVISION.md) ---
# Number of worker containers (use scripts/up-with-scale.sh or: docker compose up -d --scale worker=4)
# WORKER_REPLICAS=4
# Work division: workers poll fullest queue first (default true). Set false for fixed order.
# QUEUE_WORK_DIVISION=true
# Clustering: merge into cluster if similarity > threshold (0.88=topic clustering, 0.95=dedup only). See docs/CLUSTERING_HOW_IT_WORKS.md.
# CLUSTER_SIMILARITY_THRESHOLD=0.88

# --- Vector store (optional; default pgvector) ---
# VECTOR_STORE_BACKEND=pgvector
# VECTOR_STORE_BACKEND=weaviate
# WEAVIATE_URL=http://localhost:8081

# --- 2-tier retrieval (optional; see docs/RETRIEVAL_TWOTIER.md) ---
# RETRIEVAL_TIERA_MODEL_ID=openai:text-embedding-3-small:384
# RETRIEVAL_TIERB_MODEL_ID=openai:text-embedding-3-small:768
# RETRIEVAL_TOPN=200
# RETRIEVAL_RERANKN=80
# EMBEDDING_CACHE_PATH=/var/lib/sentiment_api/embedding_cache.sqlite
# WEAVIATE_CHUNK_CLASS=RetrievalChunk

# --- Observability (optional) ---
SENTIMENT_API_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
