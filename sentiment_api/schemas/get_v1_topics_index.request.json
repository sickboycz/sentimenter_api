{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentiment-api.local/schemas/v1/get_v1_topics_index.request.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "minLength": 16
    },
    "interval": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "1d"
      ]
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "until": {
      "type": "string",
      "format": "date-time"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 50
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "cursor": {
      "type": "string"
    }
  },
  "required": [
    "api_key"
  ]
}