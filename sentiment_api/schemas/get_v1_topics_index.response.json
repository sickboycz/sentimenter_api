{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentiment-api.local/schemas/v1/get_v1_topics_index.response.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "defs.json#/$defs/ResponseMeta"
    },
    "pagination": {
      "$ref": "defs.json#/$defs/Pagination"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "topic_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32
          },
          "topic_name_en": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "index_value": {
            "type": "number"
          },
          "sentiment": {
            "$ref": "defs.json#/$defs/Direction"
          },
          "news_volume": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "ts",
          "topic_id",
          "topic_name_en",
          "index_value",
          "sentiment",
          "news_volume"
        ]
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/Error"
      }
    }
  },
  "required": [
    "meta",
    "pagination",
    "data",
    "errors"
  ]
}