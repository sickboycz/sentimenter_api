{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentiment-api.local/schemas/v1/get_v1_universe_constituents.request.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "minLength": 16
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "cursor": {
      "type": "string"
    },
    "sector_id": {
      "$ref": "defs.json#/$defs/SectorId"
    },
    "q": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "api_key"
  ]
}