{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentiment-api.local/schemas/v1/source_registry.schema.json",
  "title": "sentiment_api source registry schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "defaults",
    "packs",
    "sources"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "translate_to_en": {
          "type": "boolean"
        },
        "update_interval_sec": {
          "type": "integer",
          "minimum": 10
        },
        "credibility_tier": {
          "type": "string"
        },
        "license_class": {
          "type": "string"
        },
        "max_fetch_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "request_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "respect_robots_txt": {
          "type": "boolean"
        },
        "max_article_age_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        }
      }
    },
    "packs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "name",
          "pack",
          "type"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]{3,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "pack": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "gdelt",
              "rss",
              "api",
              "scrape",
              "dataset"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "translate_to_en": {
            "type": "boolean"
          },
          "update_interval_sec": {
            "type": "integer",
            "minimum": 10
          },
          "credibility_tier": {
            "type": "string",
            "enum": [
              "official",
              "reputable_media",
              "local_media",
              "dataset",
              "user_added"
            ]
          },
          "license_class": {
            "type": "string",
            "enum": [
              "open",
              "key_required",
              "paid",
              "restricted"
            ]
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "feed_url": {
            "type": "string"
          },
          "page_url": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "language_hint": {
            "type": "string"
          },
          "parser_profile": {
            "type": "string"
          },
          "auth": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "method": {
                "type": "string"
              },
              "key_name": {
                "type": "string"
              },
              "location": {
                "type": "string",
                "enum": [
                  "query",
                  "header"
                ]
              }
            }
          },
          "query_profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile_id",
                "query"
              ],
              "properties": {
                "profile_id": {
                  "type": "string",
                  "minLength": 1
                },
                "query": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "maxItems": 200
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "rss"
                }
              }
            },
            "then": {
              "required": [
                "feed_url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "scrape"
                }
              }
            },
            "then": {
              "required": [
                "page_url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "gdelt"
                }
              }
            },
            "then": {
              "required": [
                "base_url"
              ]
            }
          }
        ]
      }
    }
  }
}