{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentiment-api.local/schemas/v1/get_v1_health.response.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "down"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fail"
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "name",
          "status"
        ]
      }
    }
  },
  "required": [
    "status",
    "as_of",
    "checks"
  ]
}